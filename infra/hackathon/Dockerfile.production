FROM node:22.16.0-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY drizzle ./drizzle
COPY drizzle.config.ts tsconfig.base.json .nvmrc ./
RUN npm ci --include=dev
RUN npm run build --workspace @deviceops/web
RUN mkdir -p /app/.data && chown -R node:node /app/apps/web/.next /app/.data
ENV NODE_ENV=production
USER node
CMD ["npm", "run", "start", "--workspace", "@deviceops/web", "--", "--hostname", "0.0.0.0"]
