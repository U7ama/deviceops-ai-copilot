FROM deviceops-hackathon:dependencies-sep12
USER root
ENV NODE_ENV=development
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY drizzle ./drizzle
COPY drizzle.config.ts tsconfig.base.json .nvmrc ./
COPY fixtures ./fixtures
COPY docs ./docs
COPY LICENSE README.md ./
RUN mkdir -p /app/.data && chown -R node:node /app/apps/web /app/.data
USER node
