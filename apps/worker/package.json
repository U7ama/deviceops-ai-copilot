{
  "name": "@deviceops/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --outDir dist --noEmit false --declaration false --declarationMap false --sourceMap false",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deviceops/core": "*",
    "@deviceops/db": "*",
    "@deviceops/observability": "*",
    "pg-boss": "12.27.0"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
