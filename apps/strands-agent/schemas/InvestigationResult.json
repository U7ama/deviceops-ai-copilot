{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/EmptyArguments"
        },
        "name": {
          "enum": [
            "restart_service",
            "restart_switch"
          ],
          "title": "Name",
          "type": "string"
        },
        "targetDeviceId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Targetdeviceid",
          "type": "string"
        }
      },
      "required": [
        "name",
        "targetDeviceId",
        "arguments"
      ],
      "title": "Action",
      "type": "object"
    },
    "EmptyArguments": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyArguments",
      "type": "object"
    },
    "InvestigationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "artifactIds": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Artifactids",
          "type": "array"
        },
        "criticRequiresEscalation": {
          "title": "Criticrequiresescalation",
          "type": "boolean"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/SpecialistFinding"
          },
          "maxItems": 4,
          "title": "Findings",
          "type": "array"
        },
        "memoryIds": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Memoryids",
          "type": "array"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "const": "enterprise.v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "status",
        "findings",
        "criticRequiresEscalation",
        "memoryIds",
        "artifactIds"
      ],
      "title": "InvestigationEnvelope",
      "type": "object"
    },
    "SpecialistFinding": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "items": {
            "maxLength": 400,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Conflicts",
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Evidenceids",
          "type": "array"
        },
        "gaps": {
          "items": {
            "maxLength": 400,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Gaps",
          "type": "array"
        },
        "hypothesis": {
          "maxLength": 1200,
          "title": "Hypothesis",
          "type": "string"
        },
        "specialist": {
          "enum": [
            "network",
            "system",
            "power",
            "critic"
          ],
          "title": "Specialist",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "uncertainty": {
          "maxLength": 1000,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "specialist",
        "status",
        "hypothesis",
        "evidenceIds",
        "conflicts",
        "gaps",
        "uncertainty"
      ],
      "title": "SpecialistFinding",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "minimum": 0,
          "title": "Inputtokens",
          "type": "integer"
        },
        "modelCalls": {
          "maximum": 12,
          "minimum": 0,
          "title": "Modelcalls",
          "type": "integer"
        },
        "outputTokens": {
          "minimum": 0,
          "title": "Outputtokens",
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "modelCalls"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/Action"
        },
        {
          "type": "null"
        }
      ]
    },
    "alternatives": {
      "items": {
        "maxLength": 400,
        "type": "string"
      },
      "maxItems": 5,
      "title": "Alternatives",
      "type": "array"
    },
    "cause": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Cause",
      "type": "string"
    },
    "enterprise": {
      "anyOf": [
        {
          "$ref": "#/$defs/InvestigationEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidenceIds": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Evidenceids",
      "type": "array"
    },
    "modelId": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Modelid",
      "type": "string"
    },
    "provider": {
      "default": "strands-bedrock",
      "enum": [
        "strands-bedrock",
        "strands-qwen"
      ],
      "title": "Provider",
      "type": "string"
    },
    "summary": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "toolCalls": {
      "maximum": 24,
      "minimum": 0,
      "title": "Toolcalls",
      "type": "integer"
    },
    "uncertainty": {
      "maxLength": 1000,
      "title": "Uncertainty",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "summary",
    "cause",
    "evidenceIds",
    "alternatives",
    "uncertainty",
    "action",
    "modelId",
    "usage",
    "toolCalls"
  ],
  "title": "InvestigationResult",
  "type": "object"
}
