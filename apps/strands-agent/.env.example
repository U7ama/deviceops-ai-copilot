# Private worker-to-service secret, at least 32 characters. Generate locally.
STRANDS_SERVICE_TOKEN=
DEVICEOPS_URL=http://localhost:3000
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Use the AWS provider chain, preferably an instance role; never commit AWS keys.
# AWS_PROFILE=deviceops
# Trusted absolute Node command and JSON arguments, never populated from API requests.
# DEVICEOPS_MCP_COMMAND=/usr/local/bin/node
# DEVICEOPS_MCP_ARGS=["--import","tsx","/app/apps/mcp/src/index.ts"]
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_OUTPUT_PER_CALL=2000
AGENT_MAX_INPUT_TOKENS=120000
AGENT_MAX_OUTPUT_TOKENS=8000
# Set true only after actual usable promotional credits are verified.
AWS_CREDITS_CONFIRMED=false

# Explicit Gemini selection (no automatic fallback). API key stays in private service only.
# Standalone Python: STRANDS_MODEL_PROVIDER=gemini; backend: OPS_AGENT_MODE=gemini.
STRANDS_MODEL_PROVIDER=bedrock
GEMINI_MODEL_ID=gemini-3.7-flash
GEMINI_API_KEY=
# Confirm Google quota/billing separately from AWS credits before enabling.
GEMINI_USAGE_CONFIRMED=false
