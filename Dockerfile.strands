FROM node:22.16.0-bookworm-slim AS node
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NODE_ENV=production
WORKDIR /app
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY tsconfig.base.json ./
RUN npm ci --include=dev --ignore-scripts --fetch-retries=1 --fetch-timeout=60000 \
    && pip install --timeout 30 --retries 1 --no-cache-dir -r apps/strands-agent/requirements.txt \
    && useradd --create-home --uid 10001 agent
USER agent
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/healthz', timeout=2)"
CMD ["python", "-m", "uvicorn", "main:app", "--app-dir", "apps/strands-agent", "--host", "0.0.0.0", "--port", "8081", "--workers", "1", "--limit-concurrency", "16", "--no-access-log"]
