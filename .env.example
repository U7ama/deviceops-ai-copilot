# ==============================================================================
# DeviceOps — Configuration Reference & Environment Template
# ==============================================================================
# Copy to .env.demo or run: node scripts/demo-env.mjs
# Default: OPS_AGENT_MODE=fixture runs the entire demo with $0 API cost.
# For step-by-step setup and testing instructions, see README.md.
# ==============================================================================


# Application & Networking
HACKATHON_PORT=3030
NODE_ENV=development
APP_URL=http://localhost:3030

# Mode Selection
# Use 'fixture' for deterministic demo without external APIs; use 'qwen' for live LLM reasoning.
OPS_AGENT_MODE=fixture
OPS_DEMO_ENABLED=true
OPS_POLL_MS=5000
OPS_MODEL_BUDGET_USD=6

# Strands Multi-Agent Reasoning Architecture
# 'specialists' runs Network + System + Power domain specialists + Critic consistency verification.
# 'single' runs standard unified Strands agent investigation.
OPS_INVESTIGATION_WORKFLOW=specialists
STRANDS_SERVICE_URL=http://strands:8081

# Strands Transport Mode
# 'agentcore' routes investigations to the serverless AWS Bedrock AgentCore microVM runtime.
# 'http' routes investigations directly to the local private Strands container.
STRANDS_TRANSPORT=agentcore

# AWS Bedrock AgentCore Configuration (Tested in us-east-1)
# Replace with your deployed Bedrock AgentCore runtime ARN when running in live cloud mode:
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/deviceops_strands_bounded-xxxxxxxxx
AWS_REGION=us-east-1
# Must be set to 'true' only when live AWS credits/access are confirmed:
AWS_CREDITS_CONFIRMED=false

# LLM Reasoning Provider (Alibaba Cloud Model Studio / Qwen)
STRANDS_MODEL_PROVIDER=qwen
QWEN_MODEL_ID=qwen3.7-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AGENT_MAX_INPUT_TOKENS=500000
# Must be set to 'true' only when live Qwen quota/API key is confirmed:
QWEN_USAGE_CONFIRMED=false
ABQWEN_API_KEY=replace-with-your-dashscope-api-key

# Approved Media & Evidence Fixtures (SHA-256 integrity hashes for original synthetic evidence)
OPS_APPROVED_FIXTURE_HASHES=04e2c949ac21827d6ec11b576afc70c999fb5b4f4423b2f16aef39ca4331c2e4,342de926c67327186aee8f2093c852a9e83920b2cfd6f3bcf1529eb818d97bf5,d924f913e89f60d2fe32bfce5f685abaa0d5cf2b6ca2202217508de9e20c0009,c7a82ddd19a6ca6f7f5f5f3aaa999307b63791bc9f6b1ebc75714c2827c7dd8e,9dd728e61b92ac2b11282f2ce96176a5d28a5ae5a987214b25d53e54b8d1378e,79595675c421e93f2a5a612d5a77f40a46b97824e36b493c66b3971954482a46
OPS_EVIDENCE_ROOT=.data/enterprise-evidence
MEDIA_PROVIDER=local
MEDIA_SCANNER=fixture
MEDIA_ROOT=.data/media
MEDIA_ALLOW_UNSCANNED_DEV_UPLOADS=false

# Sandboxed Python Analysis Container
OPS_SANDBOX_PROVIDER=broker
OPS_SANDBOX_IMAGE=deviceops-analysis:local
SANDBOX_BROKER_URL=http://sandbox-broker:8091

# Notification & Incident Webhook Integration
OPS_N8N_WEBHOOK_URL=http://n8n:5678/webhook/operations-envelope

# ==============================================================================
# SECRETS & PASSWORDS (REPLACE WITH SECURE VALUES FOR YOUR ENVIRONMENT)
# ==============================================================================
POSTGRES_ADMIN_PASSWORD=replace-with-secure-postgres-admin-password
DEVICEOPS_APP_DB_PASSWORD=replace-with-secure-app-db-password
DATABASE_URL=postgresql://deviceops_app:replace-with-secure-app-db-password@postgres:5432/deviceops
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-secure-postgres-admin-password@postgres:5432/deviceops

SESSION_SECRET=replace-with-at-least-32-random-hex-characters
STRANDS_SERVICE_TOKEN=replace-with-at-least-32-random-hex-characters
N8N_WEBHOOK_SECRET=replace-with-random-shared-secret
N8N_ENCRYPTION_KEY=replace-with-32-character-encryption-key
SEED_PASSWORD=replace-with-operator-seed-password
