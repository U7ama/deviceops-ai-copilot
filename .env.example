NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://deviceops_app:deviceops_app_dev@127.0.0.1:5432/deviceops
DATABASE_ADMIN_URL=postgresql://postgres:deviceops_admin_dev@127.0.0.1:5432/deviceops
SESSION_SECRET=replace-with-at-least-32-random-characters
# Legacy provider: mock is offline; openai requires explicitly configured credentials.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_INPUT_COST_PER_MILLION=2.50
OPENAI_OUTPUT_COST_PER_MILLION=10.00
AI_MAX_TURNS=6
AI_MAX_TOOL_CALLS=4
AI_MAX_COST_USD=0.10
MEDIA_PROVIDER=local
MEDIA_ALLOW_LOCAL_PRODUCTION=false
MEDIA_SCANNER=fixture
MEDIA_ROOT=.data/media
MEDIA_ALLOW_UNSCANNED_DEV_UPLOADS=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/deviceops-incident
N8N_WEBHOOK_SECRET=replace-with-a-random-shared-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Operational incident workflow; fixture mode is deterministic and labelled in the UI.
OPS_AGENT_MODE=fixture
OPS_DEMO_ENABLED=true
OPS_POLL_MS=5000
OPS_MODEL_BUDGET_USD=6
STRANDS_SERVICE_URL=http://127.0.0.1:8081
STRANDS_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Both backend and Python reject paid operations until usable credits are confirmed.
AWS_CREDITS_CONFIRMED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Set after importing/activating the local n8n workflow.
OPS_N8N_WEBHOOK_URL=
# OPS_N8N_WEBHOOK_URL=http://127.0.0.1:15678/webhook/operations-envelope
# Recheck current AWS prices before enabling live mode.
NOVA_INPUT_USD_PER_MILLION=0.06
NOVA_OUTPUT_USD_PER_MILLION=0.24

# Explicit Gemini selection (no automatic fallback). API key stays in private service only.
# Standalone Python: STRANDS_MODEL_PROVIDER=gemini; backend: OPS_AGENT_MODE=gemini.
STRANDS_MODEL_PROVIDER=bedrock
GEMINI_MODEL_ID=gemini-3.7-flash
GEMINI_API_KEY=
# Confirm Google quota/billing separately from AWS credits before enabling.
GEMINI_USAGE_CONFIRMED=false

# Five-pillar mode (explicit opt-in; single investigation mode remains compatible).
OPS_INVESTIGATION_WORKFLOW=single
OPS_SANDBOX_PROVIDER=disabled
OPS_SANDBOX_IMAGE=deviceops-analysis:local
OPS_EVIDENCE_ROOT=.data/enterprise-evidence
# Optional private S3 object store; no public objects.
OPS_EVIDENCE_BUCKET=
# Approved original synthetic fixture hashes only; arbitrary uploads require ClamAV.
OPS_APPROVED_FIXTURE_HASHES=
MEDIA_CLAMAV_HOST=
STRANDS_TRANSPORT=http
AGENTCORE_RUNTIME_ARN=
AGENTCORE_CODE_INTERPRETER_ID=
